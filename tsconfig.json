{
  // TypeScript settings for this project.
  // Vite does the actual building; `tsc` is only used to CHECK types (noEmit).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Lets `import.meta.env` and `import img from "./x.png"` work.
    "types": ["vite/client"],

    // Type-check only, Vite handles the output.
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // `strict` turns on the important safety checks (like catching null values).
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
